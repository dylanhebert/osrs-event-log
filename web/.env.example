# Copy to web/.env for local development. web/.env is gitignored.
# On the droplet these are Environment= lines in the systemd unit instead.

# REQUIRED. Explicit path to an existing osrs.db. There is no default on
# purpose: the UI must never guess its way to the database the bot is writing.
# Locally this should be the snapshot pulled from the server, NEVER the bot's
# own working copy at osrs-event-log/data/osrs.db.
OSRS_DB_PATH=fixtures/ui-dev.db

# REQUIRED. Signs the session cookie. Rotating it signs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional.
SESSION_DAYS=60

# 1 behind Caddy (https), 0 for local http. A secure cookie is not sent over
# plain http, so setting this locally silently breaks sign-in.
SECURE_COOKIES=0

# Discord guild ids are semi-private and this repo is public, so display names
# live here rather than in source. Unmapped servers render as "Server 1",
# "Server 2", ... so leaving this empty is merely less friendly.
#   SERVER_NAMES=123456789012345678:Main clan,987654321098765432:Alts
SERVER_NAMES=

# Failed sign-in attempts allowed per IP per window. Per worker process, so the
# real allowance is roughly this times the worker count. Passwords are 256-bit
# random values, so this exists to stop the form being a CPU sink, not to make
# guessing infeasible.
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
